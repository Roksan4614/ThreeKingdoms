    {
      "key": "NODE_1_DESC",
      "kr": "\"천하를 뒤덮은 거대한 광기와 혼란\"",
      "en": "\"A vast madness and chaos smothering the realm\"",
      "cn": "“席卷天下的滔天狂乱”"
    },
    {
      "key": "NODE_2_DESC",
      "kr": "\"뚫리지 않는 방패\"",
      "en": "\"A shield that will not be pierced\"",
      "cn": "“无法穿透的盾”"
    },
    {
      "key": "NODE_3_DESC",
      "kr": "\"절대적 공포가 선사한 압도적인 무력감\"",
      "en": "\"The crushing helplessness that absolute terror brings\"",
      "cn": "“绝对的恐惧带来的压倒性无力感”"
    },
    {
      "key": "NODE_4_DESC",
      "kr": "\"무너지는 강동의 호랑이\"",
      "en": "\"The Tiger of Jiangdong falls\"",
      "cn": "“倒下的江东之虎”"
    },
    {
      "key": "NODE_5_DESC",
      "kr": "\"나의 장자방이로다\"",
      "en": "\"This man is my Zhang Zifang\"",
      "cn": "“此乃吾之子房也”"
    },
    {
      "key": "NODE_6_DESC",
      "kr": "\"붉은 피로 물들이다\"",
      "en": "\"Stained crimson with blood\"",
      "cn": "“以鲜血染红大地”"
    },
    {
      "key": "NODE_7_DESC",
      "kr": "\"거대한 폭력에 맞선 신념\"",
      "en": "\"Conviction standing against overwhelming violence\"",
      "cn": "“直面滔天暴力的信念”"
    },
    {
      "key": "NODE_8_DESC",
      "kr": "\"강동의 소패왕 날개를 펴다\"",
      "en": "\"The Little Conqueror of Jiangdong spreads his wings\"",
      "cn": "“江东小霸王展翅”"
    },
    {
      "key": "NODE_9_DESC",
      "kr": "\"천하보다 뜨거운 두 영웅의 의리\"",
      "en": "\"A bond between two heroes hotter than the realm itself\"",
      "cn": "“比天下更炽热的两位英雄之义”"
    },
    {
      "key": "NODE_10_DESC",
      "kr": "\"주군을 찾는 전사의 눈\"",
      "en": "\"A warrior's eyes, searching for a lord\"",
      "cn": "“寻觅主公的战士之眼”"
    },
    {
      "key": "NODE_11_DESC",
      "kr": "\"처절한 피난길의 끝은 난세의 영웅\"",
      "en": "\"At the end of a desperate flight stands the hero of a broken age\"",
      "cn": "“凄绝逃亡之路的尽头，是乱世的英雄”"
    },
    {
      "key": "NODE_12A_DESC",
      "kr": "\"소패왕의 자비 없는 진격\"",
      "en": "\"The Little Conqueror's merciless advance\"",
      "cn": "“小霸王毫无慈悲的进军”"
    },
    {
      "key": "NODE_12B_DESC",
      "kr": "\"무릎 꿇은 동오의 덕왕\"",
      "en": "\"The virtuous king of Eastern Wu brought to his knees\"",
      "cn": "“跪下的东吴德王”"
    },
    {
      "key": "NODE_13_DESC",
      "kr": "\"무너진 무신의 그늘 아래 꺾이지 않는 기개\"",
      "en": "\"An unbroken spirit beneath the shadow of a fallen god of war\"",
      "cn": "“在崩塌的武神阴影下，不曾折断的气概”"
    },
    {
      "key": "NODE_14_DESC",
      "kr": "\"천하의 영웅은 그대와 나뿐이오\"",
      "en": "\"The only heroes in this realm are you and I\"",
      "cn": "“今天下英雄，唯使君与操耳”"
    },
    {
      "key": "NODE_15_DESC",
      "kr": "\"잠룡, 난세의 영웅을 만나다\"",
      "en": "\"The hidden dragon meets the hero of a broken age\"",
      "cn": "“潜龙，遇见乱世的英雄”"
    },
    {
      "key": "NODE_16_DESC",
      "kr": "\"그에겐 그저 당연한 승리\"",
      "en": "\"To him, victory was simply a matter of course\"",
      "cn": "“于他而言，这不过是理所当然的胜利”"
    },
    {
      "key": "NODE_17_DESC",
      "kr": "\"죽음의 문턱에서\"",
      "en": "\"At death's threshold\"",
      "cn": "“在死亡的门槛上”"
    },
    {
      "key": "NODE_18_DESC",
      "kr": "\"길 잃은 명장, 인의의 깃발 아래로\"",
      "en": "\"A lost general finds his way beneath the banner of virtue\"",
      "cn": "“迷途的名将，归于仁义的旗下”"
    },
    {
      "key": "NODE_19A_DESC",
      "kr": "\"수십만 대군에 맞선 결단\"",
      "en": "\"A decision made against an army hundreds of thousands strong\"",
      "cn": "“直面数十万大军的决断”"
    },
    {
      "key": "NODE_19B_DESC",
      "kr": "\"귀신 같은 지략, 빛을 잃다\"",
      "en": "\"An uncanny genius for strategy, dimmed at last\"",
      "cn": "“鬼神般的智谋，就此失色”"
    },
    {
      "key": "NODE_20_DESC",
      "kr": "\"와룡 일어나다\"",
      "en": "\"The Sleeping Dragon awakens\"",
      "cn": "“卧龙崛起”"
    },
    {
      "key": "NODE_21A_DESC",
      "kr": "\"사선을 넘나드는 창\"",
      "en": "\"A spear crossing the line between life and death\"",
      "cn": "“往返于生死线上的长枪”"
    },
    {
      "key": "NODE_21B_DESC",
      "kr": "\"두 영웅이 열어젖힌 장판파의 혈로\"",
      "en": "\"The bloody road through Changban, torn open by two heroes\"",
      "cn": "“两位英雄杀开的长坂坡血路”"
    },
    {
      "key": "NODE_22_DESC",
      "kr": "\"사선에서 눈 뜬 여인\"",
      "en": "\"A woman who opened her eyes at death's edge\"",
      "cn": "“在生死线上睁开眼的女子”"
    },
    {
      "key": "NODE_23A_DESC",
      "kr": "\"강동의 젊은 호랑이가 보검을 뽑아들다\"",
      "en": "\"The young tiger of Jiangdong draws his treasured sword\"",
      "cn": "“江东的年轻猛虎拔出宝剑”"
    },
    {
      "key": "NODE_23B_DESC",
      "kr": "\"영웅들의 기개가 한 곳에 모이다\"",
      "en": "\"The spirit of heroes gathers in one place\"",
      "cn": "“英雄们的气概汇聚一处”"
    },
    {
      "key": "NODE_24A_DESC",
      "kr": "\"천하통일의 꿈을 삼킨 적벽의 붉은 불길\"",
      "en": "\"The red flames of Red Cliff that swallowed a dream of unifying the realm\"",
      "cn": "“吞噬一统天下之梦的赤壁红焰”"
    },
    {
      "key": "NODE_24B_DESC",
      "kr": "\"귀재의 눈에는 그저 불장난일뿐\"",
      "en": "\"In the eyes of the Uncanny Genius, nothing but playing with fire\"",
      "cn": "“在鬼才眼中，不过是场火戏罢了”"
    },
    {
      "key": "NODE_25_DESC",
      "kr": "\"의와 의의 충돌\"",
      "en": "\"Righteousness against righteousness\"",
      "cn": "“义与义的冲突”"
    },
    {
      "key": "NODE_26_DESC",
      "kr": "\"세월을 거스른 백발의 활시위\"",
      "en": "\"A white-haired archer's bowstring, drawn against the years\"",
      "cn": "“逆着岁月的白发弓弦”"
    },
    {
      "key": "NODE_27_DESC",
      "kr": "\"도원결의의 맹세는..\"",
      "en": "\"And the oath of the Peach Garden..\"",
      "cn": "“桃园结义的誓言……”"
    },
    {
      "key": "NODE_28_DESC",
      "kr": "\"전장에서 씻는 죄책감\"",
      "en": "\"Guilt washed away on the battlefield\"",
      "cn": "“在战场上洗刷的罪恶感”"
    },
    {
      "key": "NODE_29_DESC",
      "kr": "\"진정 무신은 전장의 귀신이 되려하는가\"",
      "en": "\"Does the god of war truly mean to become a demon of the battlefield?\"",
      "cn": "“武神当真要化作战场的恶鬼吗？”"
    },
    {
      "key": "NODE_30A_DESC",
      "kr": "\"오랜 친우들과 첫 발을 내딛다\"",
      "en": "\"Taking the first step alongside old friends\"",
      "cn": "“与挚友们迈出第一步”"
    },
    {
      "key": "NODE_30B_DESC",
      "kr": "\"술잔 아래 의리를 다지다\"",
      "en": "\"An oath of brotherhood sealed over cups of wine\"",
      "cn": "“杯酒之下，结下义气”"
    },
    {
      "key": "NODE_30C_DESC",
      "kr": "\"맹장을 이끌고 천하로 포효하다\"",
      "en": "\"Leading fierce generals, he roars out into the realm\"",
      "cn": "“率领猛将，向天下咆哮”"
    },
    {
      "key": "NODE_31_DESC",
      "kr": "\"무신은 무신을 위하여\"",
      "en": "\"The god of war, for the god of war\"",
      "cn": "“武神，为武神而战”"
    },
