    {
      "key": "NODE_1_DESC",
      "kr": "\"천하를 뒤덮은 거대한 광기와 혼란\""
    },
    {
      "key": "NODE_2_DESC",
      "kr": "\"뚫리지 않는 방패\""
    },
    {
      "key": "NODE_3_DESC",
      "kr": "\"절대적 공포가 선사한 압도적인 무력감\""
    },
    {
      "key": "NODE_4_DESC",
      "kr": "\"무너지는 강동의 호랑이\""
    },
    {
      "key": "NODE_5_DESC",
      "kr": "\"나의 장자방이로다\""
    },
    {
      "key": "NODE_6_DESC",
      "kr": "\"붉은 피로 물들이다\""
    },
    {
      "key": "NODE_7_DESC",
      "kr": "\"거대한 폭력에 맞선 신념\""
    },
    {
      "key": "NODE_8_DESC",
      "kr": "\"강동의 소패왕 날개를 펴다\""
    },
    {
      "key": "NODE_9_DESC",
      "kr": "\"천하보다 뜨거운 두 영웅의 의리\""
    },
    {
      "key": "NODE_10_DESC",
      "kr": "\"주군을 찾는 전사의 눈\""
    },
    {
      "key": "NODE_11_DESC",
      "kr": "\"처절한 피난길의 끝은 난세의 영웅\""
    },
    {
      "key": "NODE_12A_DESC",
      "kr": "\"소패왕의 자비 없는 진격\""
    },
    {
      "key": "NODE_12B_DESC",
      "kr": "\"무릎 꿇은 동오의 덕왕\""
    },
    {
      "key": "NODE_13_DESC",
      "kr": "\"무너진 무신의 그늘 아래 꺾이지 않는 기개\""
    },
    {
      "key": "NODE_14_DESC",
      "kr": "\"천하의 영웅은 그대와 나뿐이오\""
    },
    {
      "key": "NODE_15_DESC",
      "kr": "\"잠룡, 난세의 영웅을 만나다\""
    },
    {
      "key": "NODE_16_DESC",
      "kr": "\"그에겐 그저 당연한 승리\""
    },
    {
      "key": "NODE_17_DESC",
      "kr": "\"죽음의 문턱에서\""
    },
    {
      "key": "NODE_18_DESC",
      "kr": "\"길 잃은 명장, 인의의 깃발 아래로\""
    },
    {
      "key": "NODE_19A_DESC",
      "kr": "\"수십만 대군에 맞선 결단\""
    },
    {
      "key": "NODE_19B_DESC",
      "kr": "\"귀신 같은 지략, 빛을 잃다\""
    },
    {
      "key": "NODE_20_DESC",
      "kr": "\"와룡 일어나다\""
    },
    {
      "key": "NODE_21A_DESC",
      "kr": "\"사선을 넘나드는 창\""
    },
    {
      "key": "NODE_21B_DESC",
      "kr": "\"두 영웅이 열어젖힌 장판파의 혈로\""
    },
    {
      "key": "NODE_22_DESC",
      "kr": "\"사선에서 눈 뜬 여인\""
    },
    {
      "key": "NODE_23A_DESC",
      "kr": "\"강동의 젊은 호랑이가 보검을 뽑아들다\""
    },
    {
      "key": "NODE_23B_DESC",
      "kr": "\"영웅들의 기개가 한 곳에 모이다\""
    },
    {
      "key": "NODE_24A_DESC",
      "kr": "\"천하통일의 꿈을 삼킨 적벽의 붉은 불길\""
    },
    {
      "key": "NODE_24B_DESC",
      "kr": "\"귀재의 눈에는 그저 불장난일뿐\""
    },
    {
      "key": "NODE_25_DESC",
      "kr": "\"의와 의의 충돌\""
    },
    {
      "key": "NODE_26_DESC",
      "kr": "\"세월을 거스른 백발의 활시위\""
    },
    {
      "key": "NODE_27_DESC",
      "kr": "\"도원결의의 맹세는..\""
    },
    {
      "key": "NODE_28_DESC",
      "kr": "\"전장에서 씻는 죄책감\""
    },
    {
      "key": "NODE_29_DESC",
      "kr": "\"진정 무신은 전장의 귀신이 되려하는가\""
    },
    {
      "key": "NODE_30A_DESC",
      "kr": "\"오랜 친우들과 첫 발을 내딛다\""
    },
    {
      "key": "NODE_30B_DESC",
      "kr": "\"술잔 아래 의리를 다지다\""
    },
    {
      "key": "NODE_30C_DESC",
      "kr": "\"맹장을 이끌고 천하로 포효하다\""
    },
    {
      "key": "NODE_31_DESC",
      "kr": "\"무신은 무신을 위하여\""
    },
